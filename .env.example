ANTHROPIC_API_KEY=your-anthropic-api-key
BRAINIAC_SECRET=your-brainiac-secret
GF_SECURITY_ADMIN_PASSWORD=your-grafana-admin-password

# REEL-MAKER — output directory and social publishing (optional)
BRAINIAC_REEL_OUTPUT_DIR=/tmp/brainiac-reels
# Public API base URL for Instagram Graph API video_url (must serve GET .../jobs/{id}/video)
BRAINIAC_REEL_PUBLIC_BASE_URL=
# Scheduled publish worker interval (seconds) and job TTL cleanup (days; 0 = disabled)
BRAINIAC_REEL_SCHEDULER_INTERVAL_S=30
BRAINIAC_REEL_JOB_TTL_DAYS=0
# Optional webhook for compose/publish lifecycle events (HMAC via BRAINIAC_REEL_WEBHOOK_SECRET)
BRAINIAC_REEL_WEBHOOK_URL=
BRAINIAC_REEL_WEBHOOK_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
TIKTOK_ACCESS_TOKEN=
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_PRIVACY_STATUS=public
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
# One-click OAuth (connect accounts via /reel or /api/v1/reel/social/oauth/*)
BRAINIAC_OAUTH_REDIRECT_BASE=http://127.0.0.1:8000
META_APP_ID=
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
